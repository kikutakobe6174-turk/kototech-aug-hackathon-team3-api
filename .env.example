# --- Storage ---
# SQLite の保存先。起動時にスキーマ作成とマスタ投入が自動で走る。
DATABASE_PATH=./data/app.db

# --- CORS ---
# フロントは Next.js のルートハンドラ経由で叩くため通常は不要。
# ブラウザから直接 API を叩いて確認したいときだけ使う。空にすると CORS 無効。
ALLOWED_ORIGINS=http://localhost:3000

# --- History ---
# 診断内容と結果を diagnoses テーブルに残すか
SAVE_HISTORY=true
# 残す件数の上限（超えた分は古いものから削除）
HISTORY_LIMIT=100

# --- Gemini（活用方法の生成） ---
# キーの取得: https://aistudio.google.com/apikey
# 未設定でも API は動く（活用方法の生成だけスキップされる）。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Interactions API のリビジョン。仕様が変わったらここを更新する。
GEMINI_API_REVISION=2026-05-20
GEMINI_TIMEOUT_SECONDS=30
# キーがあっても一時的に止めたいとき false にする
GEMINI_ENABLED=true

# --- Logging ---
# 生成したプロンプトも見たいときは DEBUG にする
LOG_LEVEL=INFO
# ログの文字コード。ターミナルが cp932 のときは cp932 にする
LOG_ENCODING=utf-8
