# --- Figma OAuth (https://www.figma.com/developers/apps) ---
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:8000/callback
FIGMA_SCOPE=files:read

# --- Frontend ---
# OAuth 完了後にリダイレクトする先（Next.js 側）
FRONTEND_URL=http://localhost:3000
# CORS 許可オリジン（カンマ区切り）
ALLOWED_ORIGINS=http://localhost:3000

# --- Session cookie ---
SESSION_COOKIE_NAME=session
SESSION_TTL_HOURS=168
# クロスドメイン構成なら COOKIE_SAMESITE=none / COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- Storage ---
DATABASE_PATH=./data/app.db
# 取得済みファイル構造を再利用する秒数（0 で常に Figma を叩く）
FILE_CACHE_TTL_SECONDS=300
# 構造化するツリーの最大深さ
MAX_TREE_DEPTH=100

# --- Dev only ---
# true にすると、ログインなしで下の Personal Access Token を使って動作確認できる
DEV_MODE=false
FIGMA_PERSONAL_ACCESS_TOKEN=
